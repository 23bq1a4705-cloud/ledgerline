# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Secret for Session & Authentication
JWT_SECRET=ledgerline-balancevault-super-secure-jwt-secret-replace-in-production-2026
JWT_EXPIRES_IN=24h

# Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Admin Bootstrap Credentials (One-time secure initialization)
INITIAL_ADMIN_EMAIL=admin@ledgerline.internal
INITIAL_ADMIN_PASSWORD=AdminSecureVault2026!
INITIAL_ADMIN_NAME="System Administrator"

# System Clearing Account ID (Double-entry contra account for deposits and withdrawals)
SYSTEM_CLEARING_ACCOUNT_NUMBER=SYS-CLEARING-000000

